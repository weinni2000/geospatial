<templates>
    <t
        t-name="base_geoengine_logo.GeoengineRenderer"
        t-inherit="base_geoengine.GeoengineRenderer"
        t-inherit-mode="extension"
    >
        <xpath expr="//GeoengineRecord" position="before">
            <img
                t-if="this.state.popupImageUrl"
                class="o_geoengine_popup_image d-block mb-2"
                t-att-src="this.state.popupImageUrl"
                alt=""
            />
        </xpath>
    </t>
</templates>
